# LawPilot AI — Enterprise Environment Configuration Template
# Copy this file to .env.local and populate with your credentials

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/lawpilot_db

# NextAuth / Enterprise JWT Secret Key
JWT_SECRET=lawpilot_enterprise_secure_jwt_secret_key_2026_x900

# Primary AI Model API Keys (Google Gemini, Groq, OpenRouter)
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cloudinary Cloud Storage (Optional - Local MongoDB fallback active when empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Subscription Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
